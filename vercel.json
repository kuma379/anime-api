{
  "version": 2,
  "buildCommand": "cd artifacts/anime-web && npm install --legacy-peer-deps && npx vite build --config vite.config.vercel.ts",
  "outputDirectory": "artifacts/anime-web/dist/public",
  "installCommand": "npm install",
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.ts" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
